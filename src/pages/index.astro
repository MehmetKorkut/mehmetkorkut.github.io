---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const latestPost = (await getCollection('blog'))
	.filter((p) => p.data.lang !== 'en')
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())[0];

const dateFmt = new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric', year: 'numeric' });

const sections = [
	{
		href: '/blog',
		name: 'Blog',
		desc: 'Essays and notes on data, economics, and the craft of paying attention.',
	},
	{
		href: '/projects',
		name: 'Projects',
		desc: 'Data-science systems taken apart — forecasting, dashboards, experiments.',
	},
	{ href: '/resume', name: 'Résumé', desc: 'Experience, education, and skills — in brief.' },
];

const tags = ['Data Science', 'Economics', 'Electric Guitar', 'Heavy Metal'];
---

<Layout
	title="Mehmet Korkut"
	description="Data scientist. A running record of one life, paid attention to — writing, projects, and the questions underneath them."
>
	<main class="mx-auto max-w-2xl px-6 py-20 sm:py-28">
		<!-- Hero -->
		<section>
			<h1 class="font-serif text-4xl leading-[1.12] tracking-tight text-charcoal sm:text-5xl">
				Signal, Sound, and the Spaces Between
			</h1>
			<div class="mt-6 h-1 w-14 rounded-full bg-gold"></div>

			<p class="mt-8 max-w-xl text-lg leading-relaxed text-charcoal/70">
				A running record of one life, paid attention to. By day I look for signal in the noise
				&mdash; data, models, and the questions underneath them. Away from the desk the same habit
				picks up a guitar, a book, a long road.
			</p>

			<p class="mt-6 font-mono text-xs tracking-wide text-charcoal/45">
				{tags.join('  ·  ')}
			</p>
		</section>

		<!-- Index of sections -->
		<nav class="mt-20" aria-label="Sections">
			<ul class="border-t border-charcoal/12">
				{
					sections.map((s) => (
						<li>
							<a
								href={s.href}
								class="group flex items-baseline gap-4 border-b border-charcoal/12 py-5"
							>
								<span class="font-serif text-xl text-charcoal transition-colors group-hover:text-charcoal">
									{s.name}
								</span>
								<span class="hidden flex-1 text-sm leading-snug text-charcoal/50 sm:block">
									{s.desc}
								</span>
								<span
									class="ml-auto text-lg text-charcoal/25 transition-all group-hover:translate-x-1 group-hover:text-gold"
									aria-hidden="true"
								>
									&rarr;
								</span>
							</a>
						</li>
					))
				}
			</ul>
		</nav>

		<!-- Latest -->
		{
			latestPost && (
				<section class="mt-16">
					<p class="font-mono text-xs font-semibold tracking-[0.25em] text-charcoal/40 uppercase">
						Latest
					</p>
					<a href={`/blog/${latestPost.id}`} class="group mt-3 flex items-baseline justify-between gap-5">
						<span class="font-serif text-lg leading-snug text-charcoal decoration-gold decoration-2 underline-offset-4 group-hover:underline">
							{latestPost.data.title}
						</span>
						<time
							datetime={latestPost.data.date.toISOString()}
							class="shrink-0 font-mono text-xs text-charcoal/45"
						>
							{dateFmt.format(latestPost.data.date)}
						</time>
					</a>
				</section>
			)
		}
	</main>
</Layout>
