---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const recentPosts = (await getCollection('blog'))
	.filter((p) => p.data.lang !== 'en')
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
	.slice(0, 5);

// Log-style ISO dates (YYYY-MM-DD), like a file listing.
const isoDate = (d: Date) => d.toISOString().slice(0, 10);

const sections = [
	{
		href: '/blog',
		name: 'Blog',
		desc: 'I write about almost everything. It can be a book review, an experience, or a technical project.',
	},
	{
		href: '/projects',
		name: 'Projects',
		desc: 'Personal data based projects.',
	},
	{ href: '/resume', name: 'Résumé', desc: 'Experience, education, and skills ' },
];

const tags = ['Data Science', 'Triathlon', 'Heavy Metal', 'Books'];
---

<Layout
	title="Mehmet Korkut"
	description="Just a human being who likes data, books, heavy metal and triathlon"
	contours="full"
>
	<main class="mx-auto max-w-2xl px-6 py-20 sm:py-28">
		<!-- Hero -->
		<section>
			<h1 class="font-serif text-4xl leading-[1.12] tracking-tight text-charcoal sm:text-5xl">
				Signal, Sound, and the Spaces Between
			</h1>
			<div class="mt-6 h-1 w-14 rounded-full bg-gold"></div>

			<p class="mt-8 max-w-xl text-lg leading-relaxed text-charcoal/70">
				This is a personal space for sharing my thoughts on various topics and showcase some of my
				personal-small data projects.
				
			</p>

			<p class="mt-6 font-mono text-xs tracking-wide text-charcoal/45">
				{tags.join('  ·  ')}
			</p>
		</section>

		<!-- Index of sections -->
		<nav class="mt-20" aria-label="Sections">
			<ul class="border-t border-charcoal/12">
				{
					sections.map((s) => (
						<li>
							<a
								href={s.href}
								class="group flex items-baseline gap-4 border-b border-charcoal/12 py-5"
							>
								<span class="font-serif text-xl text-charcoal transition-colors group-hover:text-charcoal">
									{s.name}
								</span>
								<span class="hidden flex-1 text-sm leading-snug text-charcoal/50 sm:block">
									{s.desc}
								</span>
								<span
									class="ml-auto text-lg text-charcoal/25 transition-all group-hover:translate-x-1 group-hover:text-gold"
									aria-hidden="true"
								>
									&rarr;
								</span>
							</a>
						</li>
					))
				}
			</ul>
		</nav>

		<!-- Recent posts, as a log -->
		{
			recentPosts.length > 0 && (
				<section class="mt-16" aria-labelledby="recent-label">
					<p id="recent-label" class="font-mono text-xs text-charcoal/45">
						<span aria-hidden="true">$ </span>ls -t ~/blog
					</p>
					<ol class="mt-4 font-mono text-sm">
						{recentPosts.map((post) => (
							<li>
								<a
									href={`/blog/${post.id}`}
									class="group flex items-baseline gap-4 py-2 sm:gap-6"
								>
									<time
										datetime={post.data.date.toISOString()}
										class="shrink-0 text-xs text-charcoal/45 tabular-nums"
									>
										{isoDate(post.data.date)}
									</time>
									<span class="min-w-0 flex-1 leading-snug text-charcoal">
										<span class="log-link">{post.data.title}</span>
									</span>
									<span
										class="shrink-0 text-charcoal/30 transition-all group-hover:translate-x-1 group-hover:text-charcoal"
										aria-hidden="true"
									>
										-&gt;
									</span>
								</a>
							</li>
						))}
					</ol>
					<a
						href="/blog"
						class="mt-4 inline-block font-mono text-xs text-charcoal/50 underline-offset-4 transition-colors hover:text-charcoal hover:underline"
					>
						all posts -&gt;
					</a>
				</section>
			)
		}
	</main>
</Layout>
