---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import MiniChart from '../components/MiniChart.astro';
import activitySummary from '../data/activities-summary.json';

const projects = (await getCollection('projects')).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const featured = projects.find((p) => p.data.featured) ?? projects[0];
const rest = projects.filter((p) => p.id !== featured?.id);

const dateFmt = new Intl.DateTimeFormat('en-US', { month: 'long', year: 'numeric' });

// Small real-data charts for the cards. The triathlon project gets its
// training hours per year straight from the Strava summary; other projects
// can declare a single headline figure in frontmatter.
const { range } = activitySummary;
const hoursByYear: number[] = [];
for (let y = range.startYear; y <= range.endYear; y++) {
	const secs = activitySummary.activities
		.filter((a: { y: number }) => a.y === y)
		.reduce((s: number, a: { s: number }) => s + a.s, 0);
	hoursByYear.push(Math.round(secs / 3600));
}
// The data export is dated; if it ends mid-year, the last point is partial.
const lastYearPartial = new Date(activitySummary.generatedAt).getFullYear() === range.endYear;

type Project = (typeof projects)[number];
const chartFor = (p: Project) => {
	if (p.id === 'triathlon-analytics') {
		return {
			kind: 'line' as const,
			values: hoursByYear,
			startLabel: String(range.startYear),
			endLabel: lastYearPartial ? `${range.endYear}*` : String(range.endYear),
			partialLast: lastYearPartial,
			caption: `training hours per year${lastYearPartial ? ` · *${range.endYear} so far` : ''}`,
		};
	}
	if (p.data.figure) {
		return {
			kind: 'meter' as const,
			value: p.data.figure.value,
			valueLabel: p.data.figure.label,
			caption: p.data.figure.caption,
		};
	}
	return null;
};
const featuredChart = featured ? chartFor(featured) : null;
---

<Layout
	title="Projects — The Laboratory"
	description="Technical breakdowns of data science systems — LTV forecasting, quality-score indices, and personal data experiments."
>
	<main class="mx-auto max-w-5xl px-6 py-12 sm:py-16">
		<header class="mb-12 border-b border-charcoal/10 pb-8">
			<p class="text-xs font-semibold tracking-[0.3em] text-rust uppercase">The Laboratory</p>
			<h1 class="mt-3 font-serif text-4xl text-charcoal sm:text-5xl">Projects</h1>
			<p class="mt-4 max-w-2xl font-serif text-lg leading-relaxed text-charcoal/75">
				Production-grade data science systems, taken apart. The methods that worked, the ones that
				didn't, and the reasoning in between.
			</p>
		</header>

		<!-- Featured project -->
		{
			featured && (
				<section class="mb-16">
					<div class="rounded-md border border-forest/25 bg-forest/[0.04] p-7 sm:p-9">
						<div class="flex flex-wrap items-center gap-3">
							<span class="rounded-full bg-forest px-3 py-0.5 text-xs font-semibold tracking-wide text-paper uppercase">
								Featured
							</span>
							<span class="text-sm text-charcoal/50">{dateFmt.format(featured.data.date)}</span>
						</div>
						<h2 class="mt-4 font-serif text-3xl leading-tight text-charcoal">
							{featured.data.title}
						</h2>
						<p class="mt-4 max-w-3xl font-serif text-lg leading-relaxed text-charcoal/80">
							{featured.data.description}
						</p>

						<div class="mt-7 grid gap-6 sm:grid-cols-[1fr_auto] sm:items-end">
							<dl class="space-y-3 font-mono text-xs">
								<div>
									<dt class="text-charcoal/45">methodology</dt>
									<dd class="mt-1 leading-relaxed text-charcoal/80">
										{featured.data.methodology.join(' · ')}
									</dd>
								</div>
								<div>
									<dt class="text-charcoal/45">stack</dt>
									<dd class="mt-1 leading-relaxed text-charcoal/80">
										{featured.data.techStack.join(' · ')}
									</dd>
								</div>
							</dl>
							{featuredChart && <MiniChart {...featuredChart} />}
						</div>

						<div class="mt-7 flex flex-wrap items-center gap-4">
							{featured.id === 'triathlon-analytics' && (
								<a
									href="/multisport"
									class="inline-flex items-center gap-2 rounded-full bg-forest px-5 py-2 text-sm font-semibold text-paper transition-opacity hover:opacity-90"
								>
									Explore the dashboard
									<span aria-hidden="true">&rarr;</span>
								</a>
							)}
							{featured.data.repo && (
								<a
									href={featured.data.repo}
									target="_blank"
									rel="noopener"
									class="inline-flex items-center gap-2 text-sm font-semibold text-forest transition-colors hover:text-rust"
								>
									<svg class="h-4 w-4" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
										<path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"></path>
									</svg>
									View on GitHub
								</a>
							)}
						</div>
					</div>
				</section>
			)
		}

		<!-- Other projects -->
		{
			rest.length > 0 && (
				<section class="mb-16">
					<div class="grid gap-6 sm:grid-cols-2">
						{rest.map((project) => (
							<article class="flex flex-col rounded-md border border-charcoal/10 bg-paper p-6 transition-colors hover:border-forest/40">
								<span class="text-sm text-charcoal/50">{dateFmt.format(project.data.date)}</span>
								<h3 class="mt-2 font-serif text-xl text-charcoal">{project.data.title}</h3>
								<p class="mt-2 flex-1 font-serif text-[0.98rem] leading-relaxed text-charcoal/75">
									{project.data.description}
								</p>
								<p class="mt-4 font-mono text-xs leading-relaxed text-charcoal/60">
									{project.data.techStack.join(' · ')}
								</p>
								{(() => {
									const chart = chartFor(project);
									return chart && <div class="mt-4"><MiniChart {...chart} /></div>;
								})()}
								{(project.data.repo || project.data.post) && (
									<div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-1 border-t border-charcoal/10 pt-4 text-sm font-semibold">
										{project.data.repo && (
											<a
												href={project.data.repo}
												target="_blank"
												rel="noopener"
												class="inline-flex items-center gap-1.5 text-forest transition-colors hover:text-rust"
											>
												<svg class="h-4 w-4" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
													<path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"></path>
												</svg>
												View on GitHub
											</a>
										)}
										{project.data.post && (
											<a
												href={project.data.post}
												class="inline-flex items-center gap-1 text-charcoal/60 transition-colors hover:text-forest"
											>
												Read the write-up <span aria-hidden="true">&rarr;</span>
											</a>
										)}
									</div>
								)}
							</article>
						))}
					</div>
				</section>
			)
		}

	</main>
</Layout>
