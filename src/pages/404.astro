---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="404 — Off the map"
	description="The page you're looking for isn't on the map."
	contours="full"
>
	<main class="mx-auto max-w-2xl px-6 py-24 sm:py-32">
		<!-- The shell echo is filled in with the real path on the client. -->
		<p class="font-mono text-xs text-charcoal/45">
			<span aria-hidden="true">$ </span>cd <span id="missing-path">this-page</span>
			<br />
			<span class="text-charcoal/60">cd: no such file or directory</span>
		</p>

		<h1 class="mt-8 font-serif text-7xl leading-none tracking-tight text-charcoal sm:text-8xl">
			404
		</h1>
		<p class="mt-6 font-serif text-2xl leading-snug text-charcoal sm:text-3xl">
			You've wandered off the trail.
		</p>
		<p class="mt-4 max-w-md text-lg leading-relaxed text-charcoal/65">
			No path on this map leads here. The page may have moved, or it was never charted in the first
			place.
		</p>

		<nav class="mt-10 flex flex-wrap gap-x-8 gap-y-3 font-mono text-sm" aria-label="Back to the map">
			<a href="/" class="group text-charcoal">
				<span class="log-link">cd ~</span>
				<span class="ml-1.5 text-charcoal/30 transition-colors group-hover:text-charcoal" aria-hidden="true">
					-&gt;</span
				>
			</a>
			<a href="/blog" class="group text-charcoal">
				<span class="log-link">ls ~/blog</span>
				<span class="ml-1.5 text-charcoal/30 transition-colors group-hover:text-charcoal" aria-hidden="true">
					-&gt;</span
				>
			</a>
		</nav>
	</main>
</Layout>

<script>
	const el = document.getElementById('missing-path');
	if (el) {
		let path = location.pathname;
		try {
			path = decodeURIComponent(path);
		} catch {}
		el.textContent = `~${path.replace(/\/$/, '')}`;
	}
</script>
