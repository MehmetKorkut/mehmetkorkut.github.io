---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
	.filter((p) => p.data.lang !== 'en')
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const dateFmt = new Intl.DateTimeFormat('en-US', {
	month: 'short',
	day: 'numeric',
	year: 'numeric',
});

function stripMarkdown(markdown: string) {
	return markdown
		.replace(/^#+\s+/gm, '')
		.replace(/\[(.*?)\]\(.*?\)/g, '$1')
		.replace(/[*_`>#]/g, '')
		.replace(/\s+/g, ' ')
		.trim();
}

function snippet(markdown: string, length = 240) {
	const text = stripMarkdown(markdown);
	return text.length > length ? `${text.slice(0, length).trim()}…` : text;
}
---

<Layout
	title="Blog — Logbook"
	description="Writing and thoughts on data science, economics, and the craft of paying attention."
>
	<main class="mx-auto max-w-5xl px-6 py-12 sm:py-16">
		<header class="mb-12 border-b border-charcoal/10 pb-8">
			<p class="text-xs font-semibold tracking-[0.3em] text-rust uppercase">Writing &amp; Thoughts</p>
			<h1 class="mt-3 font-serif text-4xl text-charcoal sm:text-5xl">Blog</h1>
			<p class="mt-4 max-w-2xl font-serif text-lg leading-relaxed text-charcoal/75">
				Essays and shorter notes on data science, economics, and craft &mdash; the longer thoughts
				that don't fit in a margin.
			</p>
		</header>

		<div class="mx-auto max-w-2xl">
			<!-- Posts -->
			<section>
				<ol class="space-y-10">
					{
						posts.map((post) => (
							<li class="border-b border-charcoal/10 pb-10 last:border-0">
								<time class="text-sm text-charcoal/50">{dateFmt.format(post.data.date)}</time>
								<h2 class="mt-2 font-serif text-2xl leading-snug text-charcoal">
									{post.data.title}
								</h2>
								<p class="mt-3 font-serif text-[1.05rem] leading-relaxed text-charcoal/80">
									{snippet(post.body ?? '')}
								</p>
								<ul class="mt-4 flex flex-wrap gap-2">
									{post.data.tags.map((tag) => (
										<li class="rounded-full bg-charcoal/[0.06] px-2.5 py-0.5 text-xs font-medium text-charcoal/60">
											{tag}
										</li>
									))}
								</ul>
								<a
									href={`/blog/${post.id}`}
									class="group mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-forest transition-colors hover:text-rust"
								>
									Read the post
									<span class="transition-transform group-hover:translate-x-0.5" aria-hidden="true">
										&rarr;
									</span>
								</a>
							</li>
						))
					}
					{
						posts.length === 0 && (
							<li class="text-charcoal/50">No posts yet — first one is on its way.</li>
						)
					}
				</ol>
			</section>
		</div>
	</main>
</Layout>
