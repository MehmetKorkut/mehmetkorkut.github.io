{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "artist": {
      "type": "string"
    },
    "genre": {
      "type": "string"
    },
    "releaseYear": {
      "type": "number"
    },
    "rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5
    },
    "coverImage": {
      "type": "string"
    },
    "spotlight": {
      "type": "boolean"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "artist",
    "genre",
    "releaseYear",
    "rating",
    "coverImage",
    "spotlight"
  ]
}